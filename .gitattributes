# registry.yaml is generated by scripts/build-registry.sh. Each skill's rows depend only on that skill's
# files, so a clean text merge of two branches equals regenerating from the merged skills. Changes to the
# same skill, or additions and deletions next to each other, can conflict; resolve by regenerating after
# the merge. No custom merge driver: a driver runs mid-merge, when only one side's skills are on disk.
# - linguist-generated: collapse it in GitHub diffs and exclude from language stats.
registry.yaml linguist-generated=true
# Decision records are parsed line by line; a CRLF checkout would make every record unparseable.
docs/decisions/*.md text eol=lf
.claude/rules/*.md text eol=lf
